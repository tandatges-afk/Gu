# Consistent source bytes on Windows, Linux and GitHub Actions.
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.docx binary
*.zip binary

# Keep Linux scripts intact when developers use Windows.
*.sh text eol=lf
*.service text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Prevent CRLF whitespace errors when committing release artifacts on Windows.
*.md text eol=lf
*.json text eol=lf
*.timer text eol=lf
*.ps1 text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.example text eol=lf
vps-main/gu-v5-release text eol=lf
