{
  "name": "gu-vps-postgresql",
  "version": "6.1.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:check": "node --env-file=.env.local scripts/check-db.mjs",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "db:smoke": "node --env-file=.env.local scripts/pg-smoke-test.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "pg": "^8.16.3",
    "argon2": "^0.44.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.8.0"
  }
}
