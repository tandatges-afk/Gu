'use client';
import {useCallback,useEffect,useMemo,useState,type FormEvent,type ReactNode} from 'react';
import {LayoutDashboard,CalendarDays,ShoppingBag,Boxes,Users,Wallet,Clock3,ScrollText,UserCog,TrendingUp,WashingMachine,LogOut,Plus,Search,Package,CheckCircle2,AlertTriangle,RefreshCw,ShieldCheck,ChevronLeft,ChevronRight,Settings2,Camera,Trash2,Pencil,CreditCard,Image as ImageIcon} from 'lucide-react';
type User={id:string;name:string;email:string;role:'admin'|'staff'};
type Item={id:string;name:string;sku:string;hanger_code?:string;category_id?:string;category?:string;size:string;color:string;daily_rate:string;replacement_value:string;status:string;image_urls:string[];requires_laundry:boolean};
type Customer={id:string;name:string;phone:string;note?:string};
type Order={id:string;code:string;status:string;pickup_at:string;return_at:string;customer_name:string;customer_phone:string;customer_id:string;booking_kind:string;total_vnd:string;paid_vnd:string;note:string;lines:{itemId:string;name:string;sku:string}[]};
type Staff={id:string;name:string;email:string;role:'admin'|'staff';disabled:boolean};
type Shift={id:string;staff_id:string;staff_name:string;work_date:string;shift_code:string};
type Category={id:string;name:string};
type Data={user:User;items:Item[];orders:Order[];categories:Category[];customers:Customer[];staff:Staff[];shifts:Shift[]};
type Page='overview'|'calendar'|'orders'|'inventory'|'laundry'|'customers'|'payments'|'reports'|'staff'|'shifts'|'audit'|'settings';
type Modal='order'|'item'|'customer'|'category'|'staff'|'payment'|'shift'|'return'|'editItem'|'editCustomer'|'none';
const pages:{id:Page;name:string;icon:typeof LayoutDashboard;group:string}[]=[
{id:'overview',name:'Tổng quan',icon:LayoutDashboard,group:'HOẠT ĐỘNG'},
{id:'calendar',name:'Lịch cho thuê',icon:CalendarDays,group:'HOẠT ĐỘNG'},
{id:'orders',name:'Đơn thuê',icon:ShoppingBag,group:'HOẠT ĐỘNG'},
{id:'customers',name:'Khách hàng',icon:Users,group:'HOẠT ĐỘNG'},
{id:'inventory',name:'Kho sản phẩm',icon:Boxes,group:'KHO HÀNG'},
{id:'laundry',name:'Quản lý giặt',icon:WashingMachine,group:'KHO HÀNG'},
{id:'payments',name:'Thanh toán & công nợ',icon:Wallet,group:'TÀI CHÍNH'},
{id:'reports',name:'Báo cáo',icon:TrendingUp,group:'TÀI CHÍNH'},
{id:'staff',name:'Nhân viên',icon:UserCog,group:'QUẢN TRỊ'},
{id:'shifts',name:'Đăng ký ca',icon:Clock3,group:'QUẢN TRỊ'},
{id:'audit',name:'Nhật ký thao tác',icon:ScrollText,group:'QUẢN TRỊ'},
{id:'settings',name:'Hệ thống',icon:Settings2,group:'QUẢN TRỊ'}];
const status:{[key:string]:string}={RESERVED:'Đặt trước',PICKED_UP:'Đang thuê',RETURNED:'Đã trả',CANCELLED:'Đã hủy',AVAILABLE:'Sẵn sàng',RENTED:'Đang cho thuê',LAUNDRY:'Đang giặt',MAINTENANCE:'Bảo trì',MISSING:'Thất lạc'};
const money=(n:number|string)=>Number(n||0).toLocaleString('vi-VN')+'đ';
const date=(v:string)=>{try{return new Date(v).toLocaleString('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'Asia/Ho_Chi_Minh'});}catch{return v;}};
const day=(v:string)=>{try{return new Date(v).toLocaleDateString('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric',timeZone:'Asia/Ho_Chi_Minh'});}catch{return v;}};
const vnDay=(v:Date)=>new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Ho_Chi_Minh',year:'numeric',month:'2-digit',day:'2-digit'}).format(v);
const localInput=(iso:string)=>{if(!iso)return '';const d=new Date(iso);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}T${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;};
const folded=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').toLowerCase();
function Badge({value}:{value:string}){return <span className={'badge '+(['CANCELLED','MISSING','MAINTENANCE'].includes(value)?'bad':['RESERVED','LAUNDRY'].includes(value)?'warn':['RETURNED'].includes(value)?'neutral':'')}>{status[value]||value}</span>;}
function ModalWrap({title,children,close,foot}:{title:string;children:ReactNode;close:()=>void;foot?:ReactNode}){return <div className="modalBackdrop" onMouseDown={e=>{if(e.target===e.currentTarget)close();}}><section className="modal"><div className="modalHeader"><h2>{title}</h2><button className="btn sm" onClick={close}>Đóng ×</button></div><div className="modalBody">{children}</div>{foot&&<div className="modalFooter">{foot}</div>}</section></div>;}
function F({label,children}:{label:string;children:ReactNode}){return <div className="field"><label>{label}</label>{children}</div>;}
async function api<T>(path:string,method='GET',payload?:unknown):Promise<T>{const r=await fetch(path,{method,credentials:'same-origin',headers:payload===undefined?{}:{'Content-Type':'application/json'},body:payload===undefined?undefined:JSON.stringify(payload),cache:'no-store'});const json=await r.json().catch(()=>({error:'Không đọc được phản hồi máy chủ'}));if(!r.ok)throw Error(json.error||`HTTP ${r.status}`);return json as T;}
export default function Home(){const [session,setSession]=useState<User|null>(null),[ready,setReady]=useState(false),[loginEmail,setLoginEmail]=useState(''),[loginPassword,setLoginPassword]=useState(''),[loginBusy,setLoginBusy]=useState(false);const [data,setData]=useState<Data|null>(null),[page,setPage]=useState<Page>('overview'),[modal,setModal]=useState<Modal>('none'),[busy,setBusy]=useState(false),[toast,setToast]=useState(''),[error,setError]=useState(''),[search,setSearch]=useState(''),[filter,setFilter]=useState('ALL');const [form,setForm]=useState<Record<string,string>>({}),[selected,setSelected]=useState<string[]>([]),[editing,setEditing]=useState<string>(''),[images,setImages]=useState<string[]>([]),[uploadBusy,setUploadBusy]=useState(false),[orderDetail,setOrderDetail]=useState<Order|null>(null),[checked,setChecked]=useState<string[]>([]),[missing,setMissing]=useState<string[]>([]),[month,setMonth]=useState(()=>{const d=new Date();return new Date(d.getFullYear(),d.getMonth(),1);}),[stats,setStats]=useState<{orders:number;products:number;customers:number;revenue_month:string;late:number}|null>(null),[daily,setDaily]=useState<{day:string;revenue:string}[]>([]),[audit,setAudit]=useState<Array<{id:string;action:string;entity_type:string;entity_id:string;actor:string;created_at:string}>>([]),[payments,setPayments]=useState<Array<{id:string;order_id:string;amount_vnd:string;direction:string;kind:string;created_at:string}>>([]);
const flash=(msg:string,bad=false)=>{if(bad)setError(msg);else setToast(msg);};
const load=useCallback(async()=>{try{const x=await api<Data>('/api/gu/bootstrap');setData(x);setSession(x.user);}catch(e){if(e instanceof Error&&/đăng nhập|hết hạn|HTTP 401/i.test(e.message)){setSession(null);setData(null);}else flash(e instanceof Error?e.message:'Lỗi tải dữ liệu',true);}},[]);
useEffect(()=>{api<{user:User}>('/api/auth').then(x=>{setSession(x.user);return load();}).catch(()=>{setSession(null);}).finally(()=>setReady(true));},[load]);
useEffect(()=>{if(!session)return;if(page==='reports')api<{stats:typeof stats;daily:typeof daily}>('/api/gu/reports').then(x=>{setStats(x.stats);setDaily(x.daily||[]);}).catch(e=>flash(String(e),true));if(page==='audit'&&session.role==='admin')api<{audit:typeof audit}>('/api/gu/audit').then(x=>setAudit(x.audit)).catch(e=>flash(String(e),true));if(page==='payments')api<{payments:typeof payments}>('/api/gu/payments').then(x=>setPayments(x.payments)).catch(e=>flash(String(e),true));},[page,session]);
const save=async(path:string,payload:unknown,method='POST')=>{setBusy(true);try{await api(path,method,payload);setModal('none');setOrderDetail(null);setImages([]);setSelected([]);setEditing('');setChecked([]);await load();flash('Đã cập nhật thành công');}catch(e){flash(e instanceof Error?e.message:'Không thể lưu',true);}finally{setBusy(false);}};
const show=(m:Modal,initial:Record<string,string>={},id='')=>{setForm(initial);setSelected([]);setImages([]);setEditing(id);setModal(m);};
const set=(key:string,value:string)=>setForm(p=>({...p,[key]:value}));
const items=data?.items||[],orders=data?.orders||[],customers=data?.customers||[],categories=data?.categories||[],staff=data?.staff||[],shifts=data?.shifts||[];
const filteredItems=useMemo(()=>items.filter(x=>(filter==='ALL'||x.status===filter)&&folded([x.name,x.sku,x.hanger_code||'',x.color,x.size,x.category||''].join(' ')).includes(folded(search))),[items,search,filter]);
const filteredOrders=useMemo(()=>orders.filter(x=>(filter==='ALL'||x.status===filter)&&folded([x.code,x.customer_name,x.customer_phone,x.lines.map(y=>y.name).join(' ')].join(' ')).includes(folded(search))),[orders,filter,search]);
const late=orders.filter(x=>x.status==='PICKED_UP'&&new Date(x.return_at)<new Date());
const moneyReceived=orders.reduce((a,x)=>a+Number(x.paid_vnd),0);
const openOrder=(x:Order)=>{setOrderDetail(x);setChecked([]);setMissing([]);setSelected([]);setForm({});api<{evidence:typeof evidence}>(`/api/gu/evidence?order=${x.id}`).then(r=>setEvidence(r.evidence)).catch(()=>setEvidence([]));};
const changePage=(x:Page)=>{setPage(x);setSearch('');setFilter('ALL');};
const dateStart=(y:number,m:number,d:number)=>`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
const upload=async(file:File,kind:'PRODUCT'|'EVIDENCE'='PRODUCT',orderId?:string)=>{setUploadBusy(true);try{const fd=new FormData();fd.append('file',file);fd.append('kind',kind);if(orderId)fd.append('orderId',orderId);const r=await fetch('/api/upload',{method:'POST',body:fd});const j=await r.json();if(!r.ok)throw Error(j.error||'Không thể tải ảnh');if(kind==='PRODUCT')setImages(a=>[...a,j.url]);else if(orderId)api<{evidence:typeof evidence}>(`/api/gu/evidence?order=${orderId}`).then(r=>setEvidence(r.evidence)).catch(()=>{});flash('Đã tải ảnh lên VPS');}catch(e){flash(e instanceof Error?e.message:'Lỗi tải ảnh',true);}finally{setUploadBusy(false);}};
if(!ready)return <div className="pageLoader">Đang khởi tạo GU...</div>;
if(!session)return <div className="authPage"><section className="authHero"><div className="brand"><span className="brandIcon">GU</span> GU <span className="tagline">/ Thuê đồ xinh</span></div><h1>Quản lý<br/>nhẹ nhàng hơn.</h1><p>Không gian làm việc dành riêng cho GU. Dữ liệu và tài khoản được quản lý trên VPS PostgreSQL của cửa hàng.</p><div style={{marginTop:60,color:'#a6c5ad'}}>VPS Edition · Private PostgreSQL</div></section><section className="authPane"><form className="authBox" onSubmit={async e=>{e.preventDefault();setLoginBusy(true);try{await api('/api/auth','POST',{email:loginEmail,password:loginPassword});await load();setLoginPassword('');}catch(e){flash(e instanceof Error?e.message:'Đăng nhập thất bại',true);}finally{setLoginBusy(false);}}}><div style={{fontSize:28,marginBottom:22,color:'#356549'}}>✳</div><h2>Chào mừng trở lại</h2><p className="muted">Đăng nhập để quản lý cửa hàng.</p><F label="Email"><input type="email" autoComplete="username" value={loginEmail} onChange={e=>setLoginEmail(e.target.value)} required placeholder="Email quản trị viên" /></F><F label="Mật khẩu"><input type="password" autoComplete="current-password" value={loginPassword} onChange={e=>setLoginPassword(e.target.value)} required /></F><button className="btn primary" disabled={loginBusy}>{loginBusy?'Đang đăng nhập...':'Đăng nhập vào GU →'}</button></form></section>{error&&<div className="toast error" onClick={()=>setError('')}>{error} ×</div>}</div>;
const totalDebt=orders.filter(o=>!['CANCELLED'].includes(o.status)).reduce((n,o)=>n+Math.max(0,Number(o.total_vnd)-Number(o.paid_vnd)),0);
return <div className="app"><aside className="side"><div className="brand"><span className="brandIcon">GU</span><span>GU<div className="tagline">THUÊ ĐỒ XINH</div></span></div>{['HOẠT ĐỘNG','KHO HÀNG','TÀI CHÍNH','QUẢN TRỊ'].map(g=><div key={g}><div className="navlabel">{g}</div>{pages.filter(p=>p.group===g&&(session.role==='admin'||!['staff','audit'].includes(p.id))).map(p=>{const Icon=p.icon;return <button key={p.id} className={'navbtn '+(page===p.id?'active':'')} onClick={()=>changePage(p.id)}><Icon size={17}/>{p.name}</button>;})}</div>)}<div className="sidefoot"><ShieldCheck size={16} style={{verticalAlign:'middle',marginRight:6}}/>PostgreSQL · VPS riêng<div style={{marginTop:7}}>{session.name} · {session.role}</div></div></aside><nav className="mobileBar">{pages.filter(p=>['overview','calendar','orders','inventory','customers','payments'].includes(p.id)).map(p=>{const Icon=p.icon;return <button key={p.id} className={page===p.id?'active':''} onClick={()=>changePage(p.id)}><Icon size={19}/>{p.name.replace('Quản lý ','')}</button>;})}</nav><main className="main"><header className="top"><div><div className="eyebrow">GU WORKSPACE / {page.toUpperCase()}</div><h1>{pages.find(p=>p.id===page)?.name||'GU'}</h1><p className="subtitle">{new Date().toLocaleDateString('vi-VN',{weekday:'long',day:'numeric',month:'long',year:'numeric'})} · Xin chào {session.name}</p></div><div className="actions"><select className="mobileSelect" value={page} onChange={e=>changePage(e.target.value as Page)}>{pages.filter(p=>session.role==='admin'||!['staff','audit'].includes(p.id)).map(p=><option key={p.id} value={p.id}>{p.name}</option>)}</select><button className="btn" onClick={()=>load()}><RefreshCw size={15}/> Làm mới</button><button className="btn" onClick={async()=>{await api('/api/auth','DELETE');setSession(null);setData(null);}}><LogOut size={15}/> Đăng xuất</button></div></header>
{page==='overview'&&<><div className="grid stats">{[[ShoppingBag,'Đơn thuê',orders.length.toString(),'Tổng đơn trên hệ thống'],[Boxes,'Sản phẩm',items.length.toString(),'Sản phẩm đang quản lý'],[Wallet,'Đã thu',money(moneyReceived),'Tổng thanh toán đơn'],[AlertTriangle,'Đang quá hạn',late.length.toString(),'Cần liên hệ khách hàng']].map(([Icon,label,num,note],i)=>{const Ic=Icon as typeof ShoppingBag;return <div className="stat" key={i}><span className="chipicon"><Ic size={19}/></span><div className="title">{label as string}</div><div className="num">{num as string}</div><div className="note">{note as string}</div></div>;})}</div><div className="grid panels"><section className="panel"><div className="panelHead"><h2>Đơn thuê gần đây</h2><button className="btn sm" onClick={()=>changePage('orders')}>Xem tất cả →</button></div><div className="tablewrap"><table><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày nhận</th><th>Trạng thái</th><th></th></tr></thead><tbody>{orders.slice(0,8).map(o=><tr key={o.id}><td><strong>{o.code}</strong></td><td>{o.customer_name}</td><td>{day(o.pickup_at)}</td><td><Badge value={o.status}/></td><td><button className="btn sm" onClick={()=>openOrder(o)}>Chi tiết</button></td></tr>)}</tbody></table>{!orders.length&&<div className="empty">Chưa có đơn thuê nào</div>}</div></section><section className="panel"><div className="panelHead"><h2>Việc cần chú ý</h2><span className="badge warn">{late.length} quá hạn</span></div>{late.slice(0,6).map(o=><div className="listRow" key={o.id}><div><strong>{o.customer_name}</strong><div className="subtle">{o.code} · Đến hạn {date(o.return_at)}</div></div><button className="btn sm" onClick={()=>openOrder(o)}>Mở</button></div>)}{late.length===0&&<div className="empty">Không có đơn quá hạn 🎉</div>}<div className="divider"/><h3>Thao tác nhanh</h3><div className="actions"><button className="btn primary" onClick={()=>show('order')}><Plus size={15}/> Tạo đơn thuê</button><button className="btn" onClick={()=>show('item')}><Package size={15}/> Thêm sản phẩm</button></div></section></div></>}
{page==='orders'&&<section className="panel"><div className="tools"><input className="search" placeholder="Tìm mã đơn, SĐT, khách hoặc sản phẩm..." value={search} onChange={e=>setSearch(e.target.value)}/><select value={filter} onChange={e=>setFilter(e.target.value)}>{['ALL','RESERVED','PICKED_UP','RETURNED','CANCELLED'].map(s=><option key={s} value={s}>{s==='ALL'?'Tất cả trạng thái':status[s]}</option>)}</select><button className="btn primary" onClick={()=>show('order')}><Plus size={16}/> Tạo đơn</button></div><div className="tablewrap"><table><thead><tr><th>Đơn thuê</th><th>Khách hàng</th><th>Thời gian</th><th>Sản phẩm</th><th>Tổng / Đã thu</th><th>Trạng thái</th><th></th></tr></thead><tbody>{filteredOrders.map(o=><tr key={o.id}><td><strong>{o.code}</strong></td><td>{o.customer_name}<div className="sub">{o.customer_phone}</div></td><td>{date(o.pickup_at)}<div className="sub">→ {date(o.return_at)}</div></td><td>{o.lines.map(x=>x.name).join(', ').slice(0,80)}</td><td>{money(o.total_vnd)}<div className="sub">Đã thu {money(o.paid_vnd)}</div></td><td><Badge value={o.status}/></td><td><button className="btn sm" onClick={()=>openOrder(o)}>Chi tiết</button></td></tr>)}</tbody></table>{!filteredOrders.length&&<div className="empty">Không tìm thấy đơn thuê</div>}</div></section>}
{page==='inventory'&&<><div className="tools"><input className="search" placeholder="Tìm tên, màu, mã móc, không dấu..." value={search} onChange={e=>setSearch(e.target.value)}/><select value={filter} onChange={e=>setFilter(e.target.value)}>{['ALL','AVAILABLE','RENTED','LAUNDRY','MAINTENANCE','MISSING'].map(s=><option key={s} value={s}>{s==='ALL'?'Tất cả tình trạng':status[s]}</option>)}</select><button className="btn" onClick={()=>show('category')}>Danh mục +</button><button className="btn primary" onClick={()=>show('item')}><Plus size={15}/> Sản phẩm</button></div><div className="productgrid">{filteredItems.map(it=><div className="product" key={it.id}><div className="productPhoto">{it.image_urls?.[0]?<img alt={it.name} src={it.image_urls[0]}/>:<ImageIcon size={30}/>}</div><div className="productTitle">{it.name}</div><div className="subtle">{it.sku} {it.hanger_code?'· Móc '+it.hanger_code:''}</div><div className="subtle" style={{marginTop:5}}>{it.category||'Chưa có danh mục'} · {it.color||it.size||'Một size'}</div><div className="productFoot"><strong>{money(it.daily_rate)}/ngày</strong><Badge value={it.status}/></div><div className="actions" style={{marginTop:13}}><button className="btn sm" onClick={()=>{setImages(it.image_urls||[]);setEditing(it.id);setForm({name:it.name,hangerCode:it.hanger_code||'',size:it.size,color:it.color,dailyRate:it.daily_rate,replacementValue:it.replacement_value,categoryId:it.category_id||''});setModal('editItem');}}><Pencil size={13}/> Sửa</button><button className="btn sm" onClick={()=>save(`/api/gu/items/${it.id}`,{status:it.status==='AVAILABLE'?'MAINTENANCE':'AVAILABLE'},'PATCH')}>{it.status==='AVAILABLE'?'Bảo trì':'Sẵn sàng'}</button></div></div>)}</div>{filteredItems.length===0&&<div className="empty">Chưa có sản phẩm phù hợp</div>}</>}
{page==='laundry'&&<section className="panel"><div className="panelHead"><h2>Hàng cần xử lý</h2><span className="badge warn">{items.filter(it=>it.status==='LAUNDRY').length} đang giặt</span></div>{items.filter(it=>['LAUNDRY','MAINTENANCE'].includes(it.status)).map(it=><div className="listRow" key={it.id}><div><strong>{it.name}</strong><div className="subtle">{it.sku} · {it.hanger_code||''}</div></div><div className="actions"><Badge value={it.status}/><button className="btn primary sm" onClick={()=>save(`/api/gu/items/${it.id}`,{status:'AVAILABLE'},'PATCH')}><CheckCircle2 size={14}/> Đã xong</button></div></div>)}{!items.some(it=>['LAUNDRY','MAINTENANCE'].includes(it.status))&&<div className="empty">Không có sản phẩm đang giặt hoặc bảo trì</div>}</section>}
{page==='customers'&&<section className="panel"><div className="tools"><input className="search" placeholder="Tìm SĐT hoặc tên khách (không dấu)" value={search} onChange={e=>setSearch(e.target.value)}/><button className="btn primary" onClick={()=>show('customer')}><Plus size={16}/> Thêm khách hàng</button></div><div className="tablewrap"><table><thead><tr><th>Họ tên</th><th>Số điện thoại</th><th>Ghi chú</th><th>Số đơn</th><th></th></tr></thead><tbody>{customers.filter(c=>folded(c.name+' '+c.phone).includes(folded(search))).map(c=><tr key={c.id}><td><strong>{c.name}</strong></td><td><a href={'tel:'+c.phone} style={{color:'#356448'}}>{c.phone}</a></td><td>{c.note}</td><td>{orders.filter(x=>x.customer_id===c.id).length}</td><td><button className="btn sm" onClick={()=>show('editCustomer',{name:c.name,phone:c.phone,note:c.note||''},c.id)}>Sửa</button></td></tr>)}</tbody></table></div></section>}
{page==='payments'&&<><div className="grid stats" style={{gridTemplateColumns:'repeat(2,minmax(0,1fr))'}}><div className="stat"><div className="title">Tổng đã thu từ các đơn</div><div className="num">{money(moneyReceived)}</div></div><div className="stat"><div className="title">Công nợ chưa thu</div><div className="num">{money(totalDebt)}</div></div></div><section className="panel"><div className="panelHead"><h2>Đơn hàng còn công nợ</h2><button className="btn primary" onClick={()=>show('payment')}>+ Ghi nhận thanh toán</button></div><div className="tablewrap"><table><thead><tr><th>Đơn</th><th>Khách</th><th>Tổng</th><th>Đã thu</th><th>Còn lại</th><th></th></tr></thead><tbody>{orders.filter(o=>o.status!=='CANCELLED'&&Number(o.total_vnd)>Number(o.paid_vnd)).map(o=><tr key={o.id}><td>{o.code}</td><td>{o.customer_name}</td><td>{money(o.total_vnd)}</td><td>{money(o.paid_vnd)}</td><td><strong>{money(Number(o.total_vnd)-Number(o.paid_vnd))}</strong></td><td><button className="btn sm" onClick={()=>{setForm({orderId:o.id,direction:'IN',kind:'PAYMENT'});setModal('payment');}}>Thu tiền</button></td></tr>)}</tbody></table></div><div className="divider"/><h3>Lịch sử thanh toán</h3>{payments.slice(0,30).map(p=><div className="listRow" key={p.id}><div>{orders.find(o=>o.id===p.order_id)?.code||p.order_id}<div className="subtle">{date(p.created_at)} · {p.kind}</div></div><strong style={{color:p.direction==='IN'?'#348256':'#b15757'}}>{p.direction==='IN'?'+':'−'}{money(p.amount_vnd)}</strong></div>)}</section></>}
{page==='reports'&&<><div className="grid stats">{[['Doanh thu tháng',money(stats?.revenue_month||0)],['Số đơn hàng',stats?.orders||0],['Sản phẩm',stats?.products||0],['Đơn trễ hạn',stats?.late||0]].map(([label,value])=><div className="stat" key={String(label)}><div className="title">{label}</div><div className="num">{value}</div></div>)}</div><section className="panel"><h2>Doanh thu theo ngày (60 ngày gần nhất)</h2><div style={{marginTop:26}}>{daily.map(row=><div className="listRow" key={row.day}><span>{row.day}</span><div className="progress" style={{width:'45%'}}><span style={{width:`${Math.min(100,Number(row.revenue)/Math.max(1,...daily.map(x=>Number(x.revenue)))*100)}%`}}/></div><strong>{money(row.revenue)}</strong></div>)}{!daily.length&&<div className="empty">Chưa có giao dịch nào trong 60 ngày</div>}</div></section></>}
{page==='staff'&&session.role==='admin'&&<section className="panel"><div className="panelHead"><h2>Tài khoản nhân viên</h2><button className="btn primary" onClick={()=>show('staff')}>+ Tạo tài khoản</button></div><div className="tablewrap"><table><thead><tr><th>Nhân viên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th></th></tr></thead><tbody>{staff.map(u=><tr key={u.id}><td><strong>{u.name}</strong></td><td>{u.email}</td><td>{u.role==='admin'?'Quản trị viên':'Nhân viên'}</td><td>{u.disabled?'Đã khóa':'Hoạt động'}</td><td><button className="btn sm" disabled={u.id===session.id} onClick={()=>save(`/api/gu/staff/${u.id}`,{disable:!u.disabled},'PATCH')}>{u.disabled?'Mở khóa':'Khóa'}</button></td></tr>)}</tbody></table></div></section>}
{page==='shifts'&&<section className="panel"><div className="panelHead"><h2>Ca làm việc</h2><button className="btn primary" onClick={()=>show('shift')}>+ Đăng ký ca</button></div><p className="muted">Tối đa 2 nhân viên mỗi ca. Ca S1, S2, S3 do cửa hàng quy định.</p><div className="tablewrap" style={{marginTop:16}}><table><thead><tr><th>Ngày</th><th>Ca</th><th>Nhân viên</th><th></th></tr></thead><tbody>{shifts.map(s=><tr key={s.id}><td>{s.work_date}</td><td><Badge value={s.shift_code}/></td><td>{s.staff_name}</td><td>{(session.role==='admin'||s.staff_id===session.id)&&<button className="btn sm danger" onClick={async()=>{if(!confirm('Xóa ca làm này?'))return;setBusy(true);try{await api(`/api/gu/shifts/${s.id}`,'DELETE');await load();flash('Đã xóa ca');}catch(e){flash(String(e),true);}finally{setBusy(false);}}}><Trash2 size={13}/></button>}</td></tr>)}</tbody></table></div></section>}
{page==='audit'&&session.role==='admin'&&<section className="panel"><h2>Nhật ký hệ thống</h2><div className="tablewrap" style={{marginTop:14}}><table><thead><tr><th>Thời gian</th><th>Nhân viên</th><th>Thao tác</th><th>Loại</th><th>ID</th></tr></thead><tbody>{audit.map(a=><tr key={a.id}><td>{date(a.created_at)}</td><td>{a.actor||'Hệ thống'}</td><td>{a.action}</td><td>{a.entity_type}</td><td>{a.entity_id.slice(0,15)}</td></tr>)}</tbody></table></div></section>}
{page==='settings'&&<section className="panel"><h2>Cấu hình GU VPS</h2><div className="divider"/><div className="listRow"><span>Máy chủ ứng dụng</span><strong>Next.js / Node.js 22</strong></div><div className="listRow"><span>Cơ sở dữ liệu</span><strong>PostgreSQL 16 — VPS riêng</strong></div><div className="listRow"><span>Xác thực</span><strong>Session nội bộ · Argon2id</strong></div><div className="listRow"><span>Lưu ảnh</span><strong>Ổ đĩa riêng GU_UPLOAD_DIR</strong></div><div className="listRow"><span>Firebase / Vercel</span><Badge value="Không sử dụng"/></div><div className="alert" style={{marginTop:20}}>Sao lưu database và thư mục ảnh phải được thiết lập trên VPS. Phiên bản này là mã nguồn thay thế, không nhập dữ liệu cũ từ Firebase.</div></section>}
{page==='calendar'&&<section className="panel"><div className="monthHead"><div className="actions"><button className="btn sm" onClick={()=>setMonth(new Date(month.getFullYear(),month.getMonth()-1,1))}><ChevronLeft size={16}/></button><h2>Tháng {month.getMonth()+1}/{month.getFullYear()}</h2><button className="btn sm" onClick={()=>setMonth(new Date(month.getFullYear(),month.getMonth()+1,1))}><ChevronRight size={16}/></button></div><button className="btn primary" onClick={()=>show('order')}>+ Đặt lịch thuê</button></div><div className="calendar">{['CN','T2','T3','T4','T5','T6','T7'].map(x=><div className="weekday" key={x}>{x}</div>)}{Array.from({length:Math.ceil((new Date(month.getFullYear(),month.getMonth()+1,0).getDate()+new Date(month.getFullYear(),month.getMonth(),1).getDay())/7)*7},(_,n)=>{const d=n-new Date(month.getFullYear(),month.getMonth(),1).getDay()+1,now=new Date(month.getFullYear(),month.getMonth(),d),iso=dateStart(now.getFullYear(),now.getMonth(),now.getDate()),match=orders.filter(o=>o.status!=='CANCELLED'&&vnDay(new Date(o.pickup_at))<=iso&&vnDay(new Date(o.return_at))>=iso);return <button className={'day '+(now.getMonth()!==month.getMonth()?'off ':'')+(vnDay(new Date())===iso?'today':'')} key={n} onClick={()=>show('order',{pickupAt:iso+'T09:00',returnAt:iso+'T18:00'})}><span className="dayNum">{d>0?now.getDate():''}</span>{match.slice(0,3).map(o=><div className={'event '+(o.status==='PICKED_UP'?'warn':'')} key={o.id}>{o.customer_name}</div>)}{match.length>3&&<div className="subtle">+{match.length-3} đơn</div>}</button>;})}</div></section>}
{modal!=='none'&&<ModalWrap title={({order:'Tạo đơn thuê',item:'Thêm sản phẩm',editItem:'Chỉnh sửa sản phẩm',customer:'Thêm khách hàng',editCustomer:'Sửa khách hàng',category:'Thêm danh mục',staff:'Tạo nhân viên',payment:'Ghi nhận thanh toán',shift:'Đăng ký ca',return:'Kiểm tra trả hàng',none:''})[modal]} close={()=>setModal('none')}><form className="stack" onSubmit={async(e:FormEvent)=>{e.preventDefault();switch(modal){case 'customer':await save('/api/gu/customers',form);break;case 'editCustomer':await save(`/api/gu/customers/${editing}`,form,'PATCH');break;case 'category':await save('/api/gu/categories',form);break;case 'staff':await save('/api/gu/staff',form);break;case 'item':case 'editItem':{const payload={...form,dailyRate:Number(form.dailyRate||0),replacementValue:Number(form.replacementValue||0),requiresLaundry:form.requiresLaundry!=='no',images};await save(modal==='item'?'/api/gu/items':`/api/gu/items/${editing}`,payload,modal==='item'?'POST':'PATCH');break;}case 'order':{let customerId=form.customerId;if(form.newCustomer==='yes'){setBusy(true);try{const r=await api<{customer:{id:string}}>('/api/gu/customers','POST',{name:form.newCustomerName,phone:form.newCustomerPhone});customerId=r.customer.id;}catch(e){flash(String(e),true);setBusy(false);break;}}await save('/api/gu/orders',{customerId,itemIds:selected,pickupAt:new Date(form.pickupAt||Date.now()).toISOString(),returnAt:new Date(form.returnAt||Date.now()).toISOString(),kind:form.kind||'RESERVE',note:form.note,depositDue:Number(form.depositDue||0)});break;}case 'payment':await save('/api/gu/payments',{orderId:form.orderId,direction:form.direction||'IN',amount:Number(form.amount||0),kind:form.kind||'PAYMENT',note:form.note});break;case 'shift':await save('/api/gu/shifts',{date:form.date,shift:form.shift,staffId:form.staffId});break;}}}>
{(modal==='customer'||modal==='editCustomer')&&<div className="formgrid"><F label="Tên khách hàng"><input required value={form.name||''} onChange={e=>set('name',e.target.value)}/></F><F label="Số điện thoại"><input required inputMode="tel" value={form.phone||''} onChange={e=>set('phone',e.target.value)}/></F><div className="span2"><F label="Ghi chú"><textarea value={form.note||''} onChange={e=>set('note',e.target.value)}/></F></div></div>}
{modal==='category'&&<F label="Tên danh mục"><input value={form.name||''} required onChange={e=>set('name',e.target.value)} placeholder="Áo dài, Váy, Phụ kiện..."/></F>}
{(modal==='item'||modal==='editItem')&&<><div className="formgrid"><div className="span2"><F label="Tên sản phẩm"><input required value={form.name||''} onChange={e=>set('name',e.target.value)} placeholder="Áo dài xanh lá..."/></F></div><F label="Danh mục"><select value={form.categoryId||''} onChange={e=>set('categoryId',e.target.value)}><option value="">Chọn danh mục</option>{categories.map(c=><option value={c.id} key={c.id}>{c.name}</option>)}</select></F><F label="Mã móc"><input value={form.hangerCode||''} onChange={e=>set('hangerCode',e.target.value)} placeholder="Ví dụ: A-12"/></F><F label="Kích cỡ"><input value={form.size||''} onChange={e=>set('size',e.target.value)}/></F><F label="Màu sắc"><input value={form.color||''} onChange={e=>set('color',e.target.value)}/></F><F label="Giá thuê mỗi ngày (đ)"><input required type="number" min="0" value={form.dailyRate||''} onChange={e=>set('dailyRate',e.target.value)}/></F><F label="Giá trị bồi thường (đ)"><input type="number" min="0" value={form.replacementValue||''} onChange={e=>set('replacementValue',e.target.value)}/></F></div><label className="checkline"><input type="checkbox" checked={form.requiresLaundry!=='no'} onChange={e=>set('requiresLaundry',e.target.checked?'yes':'no')}/> Cần giặt sau khi trả</label><F label="Ảnh sản phẩm (tối đa 8 MB/ảnh)"><input type="file" accept="image/jpeg,image/png,image/webp" onChange={e=>{if(e.target.files?.[0])upload(e.target.files[0]);e.currentTarget.value='';}}/><div className="chips">{images.map(x=><span className="chip" key={x}><ImageIcon size={12}/> Ảnh {images.indexOf(x)+1} <button type="button" onClick={()=>setImages(p=>p.filter(y=>y!==x))} style={{border:0,background:'transparent'}}>×</button></span>)}</div></F></>}
{modal==='staff'&&<div className="formgrid"><F label="Họ tên"><input required value={form.name||''} onChange={e=>set('name',e.target.value)}/></F><F label="Vai trò"><select value={form.role||'staff'} onChange={e=>set('role',e.target.value)}><option value="staff">Nhân viên</option><option value="admin">Admin</option></select></F><F label="Email"><input type="email" required value={form.email||''} onChange={e=>set('email',e.target.value)}/></F><F label="Mật khẩu (ít nhất 12 ký tự)"><input type="password" autoComplete="new-password" minLength={12} required value={form.password||''} onChange={e=>set('password',e.target.value)}/></F></div>}
{modal==='shift'&&<div className="formgrid"><F label="Ngày làm việc"><input type="date" required value={form.date||''} onChange={e=>set('date',e.target.value)}/></F><F label="Ca làm"><select required value={form.shift||''} onChange={e=>set('shift',e.target.value)}><option value="">Chọn ca</option>{['S1','S2','S3'].map(s=><option key={s}>{s}</option>)}</select></F>{session.role==='admin'&&<div className="span2"><F label="Nhân viên"><select value={form.staffId||session.id} onChange={e=>set('staffId',e.target.value)}>{staff.filter(s=>!s.disabled).map(s=><option value={s.id} key={s.id}>{s.name}</option>)}</select></F></div>}</div>}
{modal==='payment'&&<div className="formgrid"><div className="span2"><F label="Đơn thuê"><select required value={form.orderId||''} onChange={e=>set('orderId',e.target.value)}><option value="">Chọn đơn</option>{orders.filter(x=>x.status!=='CANCELLED').map(o=><option key={o.id} value={o.id}>{o.code} · {o.customer_name} · còn {money(Math.max(0,Number(o.total_vnd)-Number(o.paid_vnd)))}</option>)}</select></F></div><F label="Loại"><select value={form.direction||'IN'} onChange={e=>set('direction',e.target.value)}><option value="IN">Thu tiền</option><option value="OUT">Hoàn tiền</option></select></F><F label="Số tiền (đ)"><input type="number" min="0" required value={form.amount||''} onChange={e=>set('amount',e.target.value)}/></F><div className="span2"><F label="Nội dung"><input value={form.note||''} onChange={e=>set('note',e.target.value)}/></F></div></div>}
{modal==='order'&&<><div className="formgrid"><div className="span2"><F label="Khách hàng"><input placeholder="Tìm tên hoặc số điện thoại khách" value={form.customerSearch||''} onChange={e=>set('customerSearch',e.target.value)}/><select required={form.newCustomer!=='yes'} disabled={form.newCustomer==='yes'} value={form.customerId||''} onChange={e=>set('customerId',e.target.value)}><option value="">Chọn khách</option>{customers.filter(c=>folded(c.name+' '+c.phone).includes(folded(form.customerSearch||''))).slice(0,150).map(c=><option value={c.id} key={c.id}>{c.name} · {c.phone}</option>)}</select></F><label className="checkline"><input type="checkbox" checked={form.newCustomer==='yes'} onChange={e=>set('newCustomer',e.target.checked?'yes':'no')}/> Khách mới — thêm ngay khi tạo đơn</label>{form.newCustomer==='yes'&&<div className="formgrid"><F label="Tên khách mới"><input required value={form.newCustomerName||''} onChange={e=>set('newCustomerName',e.target.value)}/></F><F label="Số điện thoại mới"><input required inputMode="tel" value={form.newCustomerPhone||''} onChange={e=>set('newCustomerPhone',e.target.value)}/></F></div>}</div><F label="Ngày giờ nhận"><input required type="datetime-local" value={form.pickupAt||localInput(new Date().toISOString())} onChange={e=>set('pickupAt',e.target.value)}/></F><F label="Ngày giờ trả"><input required type="datetime-local" value={form.returnAt||localInput(new Date(Date.now()+86400000).toISOString())} onChange={e=>set('returnAt',e.target.value)}/></F><F label="Loại đơn"><select value={form.kind||'RESERVE'} onChange={e=>set('kind',e.target.value)}><option value="RESERVE">Đặt trước</option><option value="WALK_IN">Khách lấy hàng</option></select></F><F label="Đặt cọc dự kiến (đ)"><input type="number" min="0" value={form.depositDue||'0'} onChange={e=>set('depositDue',e.target.value)}/></F></div><F label="Chọn sản phẩm"><input placeholder="Tìm sản phẩm không dấu, theo màu, mã móc" value={form.productSearch||''} onChange={e=>set('productSearch',e.target.value)}/><div style={{maxHeight:200,overflow:'auto',border:'1px solid #e8eee4',borderRadius:12,padding:'5px 13px'}}>{items.filter(i=>!['MISSING','MAINTENANCE','LAUNDRY'].includes(i.status)&&folded([i.name,i.sku,i.hanger_code||'',i.color].join(' ')).includes(folded(form.productSearch||''))).slice(0,160).map(i=><label className="checkline" key={i.id}><input type="checkbox" checked={selected.includes(i.id)} onChange={e=>setSelected(s=>e.target.checked?[...s,i.id]:s.filter(x=>x!==i.id))}/><span>{i.name} · {i.sku} · {money(i.daily_rate)}/ngày</span></label>)}</div><span className="subtle">Đã chọn {selected.length} sản phẩm. Hệ thống từ chối lịch trùng khi lưu.</span></F><F label="Ghi chú"><textarea value={form.note||''} onChange={e=>set('note',e.target.value)}/></F></>}
<div className="actions" style={{justifyContent:'flex-end'}}><button className="btn" type="button" onClick={()=>setModal('none')}>Hủy</button><button type="submit" className="btn primary" disabled={busy||uploadBusy||(modal==='order'&&selected.length===0)}>{busy?'Đang lưu...':uploadBusy?'Đang tải ảnh...':'Lưu thông tin'}</button></div></form></ModalWrap>}
{orderDetail&&<ModalWrap title={'Đơn hàng '+orderDetail.code} close={()=>setOrderDetail(null)}><div className="stack"><div className="listRow"><strong>{orderDetail.customer_name} · {orderDetail.customer_phone}</strong><Badge value={orderDetail.status}/></div><div className="formgrid"><div><div className="subtle">Ngày nhận</div><strong>{date(orderDetail.pickup_at)}</strong></div><div><div className="subtle">Ngày trả</div><strong>{date(orderDetail.return_at)}</strong></div><div><div className="subtle">Tổng tiền</div><strong>{money(orderDetail.total_vnd)}</strong></div><div><div className="subtle">Đã thu / Còn lại</div><strong>{money(orderDetail.paid_vnd)} / {money(Math.max(0,Number(orderDetail.total_vnd)-Number(orderDetail.paid_vnd)))}</strong></div></div><div className="divider"/><h3>Sản phẩm trong đơn</h3>{orderDetail.lines.map(x=><div className="listRow" key={x.itemId}><span>{x.name} · {x.sku}</span>{orderDetail.status==='PICKED_UP'&&<span className="actions"><label className="checkline"><input type="checkbox" checked={checked.includes(x.itemId)} onChange={e=>{setChecked(p=>e.target.checked?[...p,x.itemId]:p.filter(t=>t!==x.itemId));if(e.target.checked)setMissing(p=>p.filter(t=>t!==x.itemId));}}/>Đủ đồ</label><label className="checkline"><input type="checkbox" checked={missing.includes(x.itemId)} onChange={e=>{setMissing(p=>e.target.checked?[...p,x.itemId]:p.filter(t=>t!==x.itemId));if(e.target.checked)setChecked(p=>p.filter(t=>t!==x.itemId));}}/>Thiếu</label></span>}</div>)}{['RESERVED','PICKED_UP'].includes(orderDetail.status)&&<details><summary className="btn" style={{display:'inline-flex'}}>+ Thêm sản phẩm vào đơn</summary><div style={{marginTop:12}}><input placeholder="Tìm sản phẩm để thêm" value={form.addSearch||''} onChange={e=>set('addSearch',e.target.value)}/><div style={{maxHeight:180,overflow:'auto',marginTop:8}}>{items.filter(x=>!orderDetail.lines.some(l=>l.itemId===x.id)&&!['LAUNDRY','MAINTENANCE','MISSING'].includes(x.status)&&folded(x.name+' '+x.sku+' '+(x.hanger_code||'')).includes(folded(form.addSearch||''))).slice(0,150).map(x=><label className="checkline" key={x.id}><input type="checkbox" checked={selected.includes(x.id)} onChange={e=>setSelected(p=>e.target.checked?[...p,x.id]:p.filter(v=>v!==x.id))}/>{x.name} · {money(x.daily_rate)}/ngày</label>)}</div><button className="btn primary sm" disabled={!selected.length||busy} onClick={()=>save(`/api/gu/orders/${orderDetail.id}`,{action:'ADD_ITEMS',itemIds:selected})}>Thêm {selected.length} sản phẩm</button></div></details>}{orderDetail.status==='PICKED_UP'&&<><F label="Phí phát sinh / bồi thường (đ)"><input type="number" min="0" value={form.extraFee||'0'} onChange={e=>set('extraFee',e.target.value)}/></F>{missing.length>0&&<div className="alert">{missing.length} sản phẩm thiếu: hệ thống tự cộng tiền bồi thường theo giá trị sản phẩm. Có thể thêm phí khác bên trên.</div>}<F label="Ghi chú kiểm tra"><textarea value={form.extraNote||''} onChange={e=>set('extraNote',e.target.value)}/></F></>}<div className="actions">{orderDetail.status==='RESERVED'&&<><button className="btn primary" onClick={()=>save(`/api/gu/orders/${orderDetail.id}`,{status:'PICKED_UP'},'PATCH')}>Xác nhận giao hàng</button>{session.role==='admin'&&<button className="btn danger" onClick={()=>{if(confirm('Hủy đơn này?'))save(`/api/gu/orders/${orderDetail.id}`,{status:'CANCELLED'},'PATCH');}}>Hủy đơn</button>}</>}{orderDetail.status==='PICKED_UP'&&<button className="btn primary" disabled={checked.length+missing.length!==orderDetail.lines.length} onClick={()=>save(`/api/gu/orders/${orderDetail.id}`,{status:'RETURNED',checkedItemIds:checked,missingItemIds:missing,extraFee:Number(form.extraFee||0),extraNote:form.extraNote},'PATCH')}><CheckCircle2 size={15}/> Xác nhận trả hàng</button>}<button className="btn" onClick={()=>{setOrderDetail(null);show('payment',{orderId:orderDetail.id,direction:'IN',kind:'PAYMENT'});}}>Thanh toán</button></div><F label="Chụp ảnh sản phẩm khi giao/nhận (nhân viên được tải lên)"><input type="file" accept="image/jpeg,image/png,image/webp" disabled={uploadBusy} onChange={e=>{if(e.target.files?.[0])upload(e.target.files[0],'HANDOVER',orderDetail.id);e.currentTarget.value='';}}/></F>{session.role==='admin'&&<F label="Ảnh chứng từ nhạy cảm (chỉ Admin được xem)"><input type="file" accept="image/jpeg,image/png,image/webp" disabled={uploadBusy} onChange={e=>{if(e.target.files?.[0])upload(e.target.files[0],'EVIDENCE',orderDetail.id);e.currentTarget.value='';}}/></F>}<div className="chips">{evidence.map(x=><a className="chip" key={x.id} href={'/api/media/'+x.id} target="_blank" rel="noopener noreferrer">{x.kind==='EVIDENCE'?'Chứng từ':'Ảnh giao nhận'} · {date(x.created_at)}</a>)}</div></div></ModalWrap>}
{toast&&<div className="toast" onClick={()=>setToast('')}>{toast} ×</div>}{error&&<div className="toast error" onClick={()=>setError('')}>{error} ×</div>}</main></div>;
}
