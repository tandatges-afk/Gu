# /etc/gu-v546/backup-prod.env (root:root, mode 600)
# Import GPG PUBLIC key to root keyring; keep PRIVATE decryption key OFF the VPS.
GU_BACKUP_GPG_RECIPIENT=FINGERPRINT_OF_EXTERNAL_BACKUP_PUBLIC_KEY
# Must point at a configured REMOTE rclone destination (outside this VPS).
GU_BACKUP_RCLONE_DEST=offsite:gu/fix20/prod
