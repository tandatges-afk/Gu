# Firebase project GU: gugu-547e3
# Firebase Console > Project settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gugu-547e3.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gugu-547e3
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Console > Project settings > Service accounts > Generate new private key.
# DO NOT commit the private key. Keep all server secrets out of NEXT_PUBLIC_ variables.
FIREBASE_PROJECT_ID=gugu-547e3
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Cloudinary > Programmable Media > API Keys / credentials.
# Cloudinary Free does NOT require Firebase Storage or Firebase Blaze.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GU 4.2 System dashboard: service account needs Cloud Monitoring viewer permission
# (monitoring.timeSeries.list) and Cloud Monitoring API enabled; optional if unavailable.
# Never set CLOUDINARY_API_SECRET or FIREBASE_PRIVATE_KEY as NEXT_PUBLIC_.

# Vercel Cron chỉ chạy xóa ảnh hết hạn khi có CRON_SECRET (không commit giá trị thật)
CRON_SECRET=
