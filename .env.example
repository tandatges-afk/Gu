# Copy to .env.local on VPS (never commit .env.local)
APP_URL=https://v5.guthuedo.io.vn
DATABASE_URL=postgresql://gu_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/gu_db
GU_UPLOAD_DIR=/var/lib/gu-v546/uploads
GU_SESSION_SECRET=REPLACE_WITH_64_OR_MORE_RANDOM_CHARACTERS
GU_SHIFT_ENFORCE_FROM=2026-11-02
CRON_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
# Metadata - set at deploy time, not a secret
GU_DEPLOY_COMMIT=staging

# Optional CPU-only local visual model. Only enable after worker is installed.
GU_VISUAL_AI_ENABLED=false
GU_VISUAL_AI_PORT=3395
# GU_VISUAL_AI_SECRET=(set in protected server env, never commit)
