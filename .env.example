# Do not commit .env.local
DATABASE_URL="postgresql://gu_app:REPLACE_PASSWORD@127.0.0.1:5432/gu_db"
# Directory outside web root, writable by guapp
GU_UPLOAD_DIR="/var/lib/gu/uploads"
# Set HTTPS production domain; no trailing slash. localhost:3100 when using SSH tunnel.
APP_URL="https://gu.example.com"
