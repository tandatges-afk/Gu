# Production V5 only. Put into /etc/gu-v546/prod.env with mode 600. Never commit values.
APP_URL=https://guthuedo.io.vn
DATABASE_URL=postgresql://gu_app:URL_ENCODE_PASSWORD@127.0.0.1:5432/gu_v546_prod
GU_UPLOAD_DIR=/var/lib/gu-v546-prod/uploads
GU_SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
CRON_SECRET=REPLACE_WITH_ANOTHER_OPENSSL_RAND_HEX_32
GU_SHIFT_ENFORCE_FROM=2026-11-02

# Optional CPU-only local visual model. Only enable after worker is installed.
GU_VISUAL_AI_ENABLED=false
GU_VISUAL_AI_PORT=3395
# GU_VISUAL_AI_SECRET=(set in protected server env, never commit)
