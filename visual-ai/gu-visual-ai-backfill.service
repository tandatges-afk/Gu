[Unit]
Description=GU v1 One-time visual inventory AI backfill
After=postgresql.service

[Service]
Type=oneshot
User=guapp
Group=guapp
WorkingDirectory=/var/www/gu-v546-prod-deploy/current
EnvironmentFile=/etc/gu-v546/prod.env
Environment=HF_HOME=/opt/gu-visual-ai/cache
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/gu-visual-ai/.venv/bin/python /var/www/gu-v546-prod-deploy/current/visual-ai/worker.py --backfill
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
CPUQuota=100%
