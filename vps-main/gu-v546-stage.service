[Unit]
Description=GU V5.4.6 staging PostgreSQL
After=network-online.target postgresql.service
Wants=network-online.target
[Service]
Type=simple
User=guapp
Group=guapp
WorkingDirectory=/var/www/gu-v546-stage-deploy/current
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3301
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
[Install]
WantedBy=multi-user.target
